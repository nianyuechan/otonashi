#!/bin/sh
# 推送前门禁：gofmt + build + vet（不跑 go test），跑完四个模块。
# 允许明确跳过：YZGO_SKIP_GATE=1 git push
# 收口仍用 scripts/Verify-All.ps1 -Level Full。
# 由 scripts/Install-GitHooks.ps1 安装到 .git/hooks/pre-push。
set -e
cd "$(git rev-parse --show-toplevel)"

if [ "${YZGO_SKIP_GATE:-0}" = "1" ]; then
    echo "pre-push: YZGO_SKIP_GATE=1，跳过 Fast 门禁（请记得稍后自行跑 Verify-All）" >&2
    exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
    PS=pwsh
elif command -v powershell >/dev/null 2>&1; then
    PS=powershell
else
    echo "pre-push: 未找到 PowerShell，无法运行 Fast 门禁；推送已阻止。" >&2
    echo "pre-push: 确需跳过请显式执行 YZGO_SKIP_GATE=1 git push（会在远端留下未验证提交）。" >&2
    exit 1
fi

"$PS" -NoProfile -ExecutionPolicy Bypass -File "scripts/Test-Go.ps1" -Level Fast
